# ── Clerk ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Si esta app es satélite de un dominio Clerk compartido con app-tienda:
NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_DOMAIN=       # dominio raíz de Clerk, ej: tudominio.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=  # URL de sign-in de la app principal, ej: http://localhost:3004/sign-in

# ── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Comunicación entre servicios ────────────────────────────────────────────
# API key que esta app acepta en el header x-api-key de requests entrantes
PEDIDOS_API_KEY=clave-secreta-pedidos

# URL y API key de app-tienda (para leer/actualizar productos)
TIENDA_API_URL=http://localhost:3004
TIENDA_API_KEY=clave-secreta-tienda
