generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pedido {
  id         Int      @id @default(autoincrement())
  userId     String
  productoId Int
  cantidad   Int
  estado     String   @default("pendiente")
  creadoEn   DateTime @default(now())
}
